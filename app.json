{
  "expo": {
    "name": "Aux Chat",
    "owner": "auxwall2",
    "slug": "auxchat",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "auxchat",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auxwall.auxchat",
      "buildNumber": "4",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to let you record and send voice messages directly to your contacts within the chat.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photos to let you select and share images with other users in the chat, such as sharing a photo of your exercise form or a document.",
        "NSCameraUsageDescription": "This app needs access to your camera to let you take and send photos immediately to your contacts, such as capturing a quick update or a progress photo.",
        "NSPhotoLibraryAddUsageDescription": "This app needs access to your photo library to save images you receive in the chat to your device."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.auxwall.auxchat",
      "edgeToEdgeEnabled": false,
      "versionCode": 16,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "auxchat" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photos to let you select and share images with other users in the chat, such as sharing a photo of your exercise form or a document.",
          "cameraPermission": "This app needs access to your camera to let you take and send photos immediately to your contacts, such as capturing a quick update or a progress photo."
        }
      ],
      "expo-font",
      "expo-av",
      [
        "expo-share-intent",
        {
          "iosShareExtensionBundleIdentifier": "com.auxwall.auxchat.ShareExtension",
          "iosAppGroupIdentifier": "group.com.auxwall.auxchat",
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsMovieWithMaxCount": 10,
            "NSExtensionActivationSupportsFileWithMaxCount": 10
          },
          "androidIntentFilters": ["text/*", "image/*", "video/*", "*/*"],
          "androidMultiIntentFilters": ["image/*", "video/*", "*/*"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a45d0df7-3496-4907-aa6d-7bee10eb016b"
      }
    }
  }
}
